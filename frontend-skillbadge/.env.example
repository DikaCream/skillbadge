# GenLayer RPC API URL (defaults to StudioNet)
VITE_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# GenLayer network: studionet | testnet-asimov | localnet
VITE_GENLAYER_NETWORK=studionet

# SkillBadge contract address (live StudioNet deployment). Optional: config.ts
# falls back to the live contract when this is unset.
VITE_CONTRACT_ADDRESS=0x4fd779b14531f933CD271B5DD78fC792918b53Df