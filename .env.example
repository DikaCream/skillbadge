# Copy to .env and fill in. Used by deploy scripts and integration tests.
# The deployer key lives either as a raw private key or as a keystore file.

# Deployer private key (hex, 0x-prefixed) — OR use the keystore below
DEPLOYER_PRIVATE_KEY=

# Keystore file (JSON) + password — preferred over a raw key
DEPLOYER_KEYSTORE_PATH=
DEPLOYER_KEYSTORE_PASSWORD=

# Contract address on the target network
CONTRACT_ADDRESS=

# Network: studionet | localnet
GENLAYER_NETWORK=studionet